# .env.example — copy to .env and fill in. Never commit the real .env.

# Database (docker-compose's `db` service uses these credentials by default)
DATABASE_URL=postgresql://exam_user:exam_password@localhost:5432/exam_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40

# Vector Database (pgvector) — must match the embedding model's output dimension
VECTOR_DIMENSION=1536

# Storage
STORAGE_TYPE=local  # local, s3
STORAGE_PATH=./storage
S3_BUCKET=exam-platform
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LLM Providers — LLM_PROVIDER selects which one app.services.llm.LLMService uses
# for question extraction/generation. EMBEDDING_PROVIDER separately selects which
# one app.services.embeddings.EmbeddingService uses for semantic search/matching.
# You only need to fill in the API key for the provider(s) you actually select below.
LLM_PROVIDER=openai  # openai, anthropic, gemini
EMBEDDING_PROVIDER=openai  # openai, gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Telegram
TELEGRAM_BOT_TOKEN=
# Leave blank for local dev (the app falls back to long-polling). Set to your
# public HTTPS base URL (no trailing slash) in production to use webhooks.
TELEGRAM_WEBHOOK_URL=

# Admin — generate a hash with:
#   python -c "from app.services.auth import hash_password; print(hash_password('your-password'))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Application
APP_NAME=AI Exam Preparation Platform
APP_ENV=development
DEBUG=true
SECRET_KEY=
CORS_ORIGINS=["http://localhost:3000"]

# Worker — jobs run as FastAPI BackgroundTasks in-process; SWEEP_SECRET
# authenticates the external cron pinger that replaces Celery beat's
# periodic quiz-expiry sweep (see /internal/sweep-expired-quizzes). Generate
# one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SWEEP_SECRET=

# Limits
MAX_FILE_SIZE=104857600
MAX_QUESTIONS_PER_QUIZ=100
MAX_QUIZ_DURATION_MINUTES=180
MAX_SEMANTIC_CACHE_ENTRIES=10000

# LangGraph — "postgres" is required for sessions to survive a restart;
# "memory" is a same-process fallback for quick local testing only.
LANGGRAPH_CHECKPOINT_STORE=postgres  # postgres, memory
LANGGRAPH_MAX_ITERATIONS=50

# Confidence thresholds for semantic exam/chapter resolution (0.0-1.0)
EXAM_MATCH_CONFIDENCE_THRESHOLD=0.7
CHAPTER_MATCH_CONFIDENCE_THRESHOLD=0.7

# Logging
LOG_LEVEL=INFO
LOG_JSON_FORMAT=true
